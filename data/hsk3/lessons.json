[{"id":"restoran","level":3,"zh":"在餐厅","title":"Di restoran","summary":"Memanggil pelayan, memesan makanan, dan membayar.","keySentences":[{"zh":"服务员，请给我菜单。","id":"Pelayan, tolong berikan saya menu.","pinyin":"fú wù yuán ， qǐng gěi wǒ cài dān 。","tokens":["服务员","，","请","给","我","菜单","。"],"tokenPinyin":["fúwùyuán","","qǐng","gěi","wǒ","càidān",""],"order":true},{"zh":"你想吃什么？","id":"Kamu ingin makan apa?","pinyin":"nǐ xiǎng chī shén me ？","tokens":["你","想","吃","什么","？"],"tokenPinyin":["nǐ","xiǎng","chī","shénme",""],"order":true},{"zh":"我要一碗米饭。","id":"Aku mau semangkuk nasi.","pinyin":"wǒ yào yì wǎn mǐ fàn 。","tokens":["我","要","一","碗","米饭","。"],"tokenPinyin":["wǒ","yào","yì","wǎn","mǐfàn",""],"order":true},{"zh":"这个菜很好吃。","id":"Masakan ini enak sekali.","pinyin":"zhè ge cài hěn hǎo chī 。","tokens":["这个","菜","很","好吃","。"],"tokenPinyin":["zhège","cài","hěn","hǎochī",""],"order":true},{"zh":"请给我一杯茶。","id":"Tolong berikan saya secangkir teh.","pinyin":"qǐng gěi wǒ yì bēi chá 。","tokens":["请","给","我","一","杯","茶","。"],"tokenPinyin":["qǐng","gěi","wǒ","yì","bēi","chá",""],"order":true},{"zh":"一共多少钱？","id":"Totalnya berapa?","pinyin":"yí gòng duō shao qián ？","tokens":["一共","多少","钱","？"],"tokenPinyin":["yígòng","duōshao","qián",""],"order":false}],"keyWords":[{"word":"服务员","pinyin":"fúwùyuán","arti":"pelayan","extra":true},{"wid":545,"word":"菜单","pinyin":"càidān","level":3,"arti":"menu"},{"wid":125,"word":"米饭","pinyin":"mǐfàn","level":1,"arti":"nasi"},{"wid":72,"word":"好吃","pinyin":"hǎochī","level":1,"arti":"enak (dimakan)"},{"wid":871,"word":"碗","pinyin":"wǎn","level":3,"arti":"mangkuk"},{"wid":17,"word":"茶","pinyin":"chá","level":1,"arti":"teh"},{"wid":483,"word":"鱼","pinyin":"yú","level":2,"arti":"ikan"},{"wid":65,"word":"贵","pinyin":"guì","level":1,"arti":"mahal"},{"wid":157,"word":"便宜","pinyin":"piányi","level":1,"arti":"murah"},{"wid":47,"word":"多少","pinyin":"duōshao","level":1,"arti":"berapa banyak"},{"wid":164,"word":"钱","pinyin":"qián","level":1,"arti":"uang"}],"steps":{"listening":[{"id":"ls-restoran-l1","type":"audio_question_pick_answer","skill":"listening","level":3,"lesson":"restoran","audio":"你想吃什么？","audio_pinyin":"nǐ xiǎng chī shén me ？","options":[{"zh":"我是学生。","pinyin":"wǒ shì xué shēng 。"},{"zh":"我在饭馆。","pinyin":"wǒ zài fàn guǎn 。"},{"zh":"我想吃米饭。","pinyin":"wǒ xiǎng chī mǐ fàn 。"}],"answer":"我想吃米饭。","explain":{"question_id":"Kamu ingin makan apa?","answer_id":"Aku ingin makan nasi."}},{"id":"ls-restoran-l2","type":"audio_dialog_question_mcq","skill":"listening","level":3,"lesson":"restoran","turns":[{"who":"女","zh":"服务员，请给我菜单。","pinyin":"fú wù yuán ， qǐng gěi wǒ cài dān 。"},{"who":"男","zh":"好的，您想喝点儿什么？","pinyin":"hǎo de ， nín xiǎng hē diǎnr shén me ？"}],"question":"女的在哪儿？","question_pinyin":"nǚ de zài nǎr ？","options":[{"zh":"在饭馆","pinyin":"zài fàn guǎn"},{"zh":"在医院","pinyin":"zài yī yuàn"},{"zh":"在学校","pinyin":"zài xué xiào"}],"answer":"在饭馆","explain":{"text_id":"Perempuan: Pelayan, tolong berikan saya menu. / Laki-laki: Baik, Anda ingin minum apa?","question_id":"Di mana si perempuan?","answer_id":"Di restoran"}},{"id":"ls-restoran-l3","type":"audio_dialog_question_mcq","skill":"listening","level":3,"lesson":"restoran","turns":[{"who":"女","zh":"一共多少钱？","pinyin":"yí gòng duō shao qián ？"},{"who":"男","zh":"一共四十五块。","pinyin":"yí gòng sì shí wǔ kuài 。"}],"question":"一共多少钱？","question_pinyin":"yí gòng duō shao qián ？","options":[{"zh":"五十四块","pinyin":"wǔ shí sì kuài"},{"zh":"四十五块","pinyin":"sì shí wǔ kuài"},{"zh":"四十块","pinyin":"sì shí kuài"}],"answer":"四十五块","explain":{"text_id":"Perempuan: Totalnya berapa? / Laki-laki: Totalnya empat puluh lima yuan.","question_id":"Totalnya berapa?","answer_id":"Empat puluh lima yuan"}}],"reading":[{"id":"ls-restoran-r1","type":"cloze_wordbank","skill":"reading","level":3,"lesson":"restoran","stem":"这个菜很（　），我还想再吃一碗。","options":[{"word":"好吃","pinyin":"hǎo chī"},{"word":"医院","pinyin":"yī yuàn"},{"word":"学校","pinyin":"xué xiào"},{"word":"朋友","pinyin":"péng you"}],"answer":"好吃","explain":{"zh":"这个菜很好吃，我还想再吃一碗。","pinyin":"zhè ge cài hěn hǎo chī ， wǒ hái xiǎng zài chī yì wǎn 。","id":"Masakan ini sangat enak, aku masih ingin makan satu mangkuk lagi."}},{"id":"ls-restoran-r2","type":"cloze_wordbank","skill":"reading","level":3,"lesson":"restoran","stem":"我想喝一（　）茶。","options":[{"word":"本","pinyin":"běn"},{"word":"件","pinyin":"jiàn"},{"word":"岁","pinyin":"suì"},{"word":"杯","pinyin":"bēi"}],"answer":"杯","explain":{"zh":"我想喝一杯茶。","pinyin":"wǒ xiǎng hē yì bēi chá 。","id":"Aku ingin minum secangkir teh."}},{"id":"ls-restoran-r3","type":"short_text_mcq","skill":"reading","level":3,"lesson":"restoran","text":"今天我和朋友去饭馆吃饭。我们看了菜单，要了鱼和米饭。鱼很好吃，也不贵，一共四十五块。","text_pinyin":"jīn tiān wǒ hé péng you qù fàn guǎn chī fàn 。 wǒ men kàn le cài dān ， yào le yú hé mǐ fàn 。 yú hěn hǎo chī ， yě bú guì ， yí gòng sì shí wǔ kuài 。","question":"★ 他们觉得鱼怎么样？","question_pinyin":"tā men jué de yú zěn me yàng ？","options":[{"zh":"很贵，不好吃","pinyin":"hěn guì ， bù hǎo chī"},{"zh":"好吃，也不贵","pinyin":"hǎo chī ， yě bú guì"},{"zh":"不好吃，但是很便宜","pinyin":"bù hǎo chī ， dàn shì hěn pián yi"}],"answer":"好吃，也不贵","explain":{"text_id":"Hari ini aku dan temanku pergi makan di restoran. Kami melihat menu dan memesan ikan dan nasi. Ikannya enak dan tidak mahal, totalnya empat puluh lima yuan.","question_id":"Bagaimana menurut mereka ikannya?","answer_id":"Enak dan tidak mahal"}}],"writing":[{"id":"ls-restoran-w1","type":"order_sentence","skill":"writing","level":3,"lesson":"restoran","stem":"Pelayan, tolong berikan saya menu.","tokens":["服务员","，","请","给","我","菜单","。"],"answer":"服务员，请给我菜单。","explain":{"zh":"服务员，请给我菜单。","pinyin":"fú wù yuán ， qǐng gěi wǒ cài dān 。","id":"Pelayan, tolong berikan saya menu."}},{"id":"ls-restoran-w2","type":"order_sentence","skill":"writing","level":3,"lesson":"restoran","stem":"Kamu ingin makan apa?","tokens":["你","想","吃","什么","？"],"answer":"你想吃什么？","explain":{"zh":"你想吃什么？","pinyin":"nǐ xiǎng chī shén me ？","id":"Kamu ingin makan apa?"}},{"id":"ls-restoran-w3","type":"order_sentence","skill":"writing","level":3,"lesson":"restoran","stem":"Aku mau semangkuk nasi.","tokens":["我","要","一","碗","米饭","。"],"answer":"我要一碗米饭。","explain":{"zh":"我要一碗米饭。","pinyin":"wǒ yào yì wǎn mǐ fàn 。","id":"Aku mau semangkuk nasi."}},{"id":"ls-restoran-w4","type":"order_sentence","skill":"writing","level":3,"lesson":"restoran","stem":"Masakan ini enak sekali.","tokens":["这个","菜","很","好吃","。"],"answer":"这个菜很好吃。","explain":{"zh":"这个菜很好吃。","pinyin":"zhè ge cài hěn hǎo chī 。","id":"Masakan ini enak sekali."}},{"id":"ls-restoran-w5","type":"order_sentence","skill":"writing","level":3,"lesson":"restoran","stem":"Tolong berikan saya secangkir teh.","tokens":["请","给","我","一","杯","茶","。"],"answer":"请给我一杯茶。","explain":{"zh":"请给我一杯茶。","pinyin":"qǐng gěi wǒ yì bēi chá 。","id":"Tolong berikan saya secangkir teh."}}]},"speaking":[{"zh":"服务员，请给我菜单。","id":"Pelayan, tolong berikan saya menu.","pinyin":"fú wù yuán ， qǐng gěi wǒ cài dān 。","tokens":["服务员","，","请","给","我","菜单","。"],"tokenPinyin":["fúwùyuán","","qǐng","gěi","wǒ","càidān",""],"order":true},{"zh":"我要一碗米饭。","id":"Aku mau semangkuk nasi.","pinyin":"wǒ yào yì wǎn mǐ fàn 。","tokens":["我","要","一","碗","米饭","。"],"tokenPinyin":["wǒ","yào","yì","wǎn","mǐfàn",""],"order":true},{"zh":"一共多少钱？","id":"Totalnya berapa?","pinyin":"yí gòng duō shao qián ？","tokens":["一共","多少","钱","？"],"tokenPinyin":["yígòng","duōshao","qián",""],"order":false}]}]